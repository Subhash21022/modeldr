    \n    walk_window = np.column_stack([walk_ax, walk_ay, walk_az, walk_gx, walk_gy, walk_gz]).astype(np.float32)\n    X_samples.append(walk_window)\n    y_labels.append(3)  # Walking\n\nX_arr = np.array(X_samples, dtype=np.float32)\ny_arr = np.array(y_labels, dtype=np.int64)\n\n# 80/20 Train-Test split\nidx = np.random.permutation(len(y_arr))\nsplit = int(0.8 * len(y_arr))\nX_train, y_train = X_arr[idx[:split]], y_arr[idx[:split]]\nX_test, y_test = X_arr[idx[split:]], y_arr[idx[split:]]\n\ntrain_loader = DataLoader(\n    list(zip(torch.from_numpy(X_train), torch.from_numpy(y_train))), \n    batch_size=128, \n    shuffle=True\n)\n\nprint(f\"✅ Prepared {len(X_train):,} training windows and {len(X_test):,} testing windows.\")\nfor c_idx, c_name in enumerate(CLASS_NAMES):\n    print(f\"   Class {c_idx} [{c_name:<16}]: {np.sum(y_arr == c_idx):,} windows\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-03T06:56:15.645811Z","iopub.execute_input":"2026-10-03T06:56:15.646226Z","iopub.status.idle":"2026-10-03T06:56:18.050243Z","shell.execute_reply.started":"2026-10-03T06:56:15.646174Z","shell.execute_reply":"2026-10-03T06:56:18.049094Z"}},"outputs":[{"name":"stdout","text":"Loading data from: /kaggle/input/datasets/subhashb21022/scooter-test-data/scooter_test_all_100hz.csv\n✅ Prepared 20,696 training windows and 5,174 testing windows.\n   Class 0 [Stationary      ]: 1,290 windows\n   Class 1 [Vehicle_Cruising]: 1,208 windows\n   Class 2 [Vehicle_Turning ]: 17,402 windows\n   Class 3 [Walking         ]: 5,970 windows\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"import os\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader\nfrom sklearn.metrics import classification_report, confusion_matrix, accuracy_score\nfrom IPython.display import FileLink, display\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(\"✅ Active compute device:\", device)\n\nCLASS_NAMES = ['Stationary', 'Vehicle_Cruising', 'Vehicle_Turning', 'Walking']\nwin = 100  # 1-second window at 100 Hz\nstep = 20\n\n# Helper to find files dynamically in /kaggle/input\ndef find_input_file(keyword):\n    for root, _, files in os.walk('/kaggle/input'):\n        for f in files:\n            if keyword.lower() in f.lower() and f.endswith('.csv'):\n                return os.path.join(root, f)\n    raise FileNotFoundError(f\"Could not find dataset file matching '{keyword}' in /kaggle/input\")\n\n# =============================================================\n# 1. LOAD VEHICLE & STATIONARY DATA (SCOOTER)\n# =============================================================\nscooter_csv = find_input_file('scooter')\nprint(f\"Loading Vehicle Telematics: {scooter_csv}\")\ndf_scooter = pd.read_csv(scooter_csv)\n\ns_feats = df_scooter[['ax', 'ay', 'az', 'gx', 'gy', 'gz']].values.astype(np.float32)\ns_speeds = df_scooter['speed_kmh'].values.astype(np.float32)\ns_gz = df_scooter['gz'].values.astype(np.float32)\n\nX_samples, y_labels = [], []\n\nfor i in range(0, len(s_feats) - win, step):\n    w_feat = s_feats[i : i + win]\n    w_speed = np.mean(s_speeds[i : i + win])\n    w_gz_max = np.max(np.abs(s_gz[i : i + win]))\n    \n    if w_speed < 1.0:\n        label = 0  # Stationary\n    elif w_speed >= 6.0 and w_gz_max > 0.38:\n        label = 2  # Vehicle Turning\n    elif w_speed >= 8.0 and w_gz_max <= 0.38:\n        label = 1  # Vehicle Cruising\n    else:\n        continue\n        \n    X_samples.append(w_feat)\n    y_labels.append(label)\n\nprint(f\"Extracted {len(X_samples):,} vehicle and stationary windows.\")\n\n# =============================================================\n# 2. LOAD & BLEND WALKING DATA (70% ForestBack + 30% RoNiN)\n# =============================================================\n# --- A. ForestBack (Forest Terrain Walking) ---\nfb_csv = find_input_file('forestback')\nprint(f\"Loading ForestBack Data: {fb_csv}\")\ndf_fb = pd.read_csv(fb_csv)\n\nfb_ax = df_fb['acc_x_mps2'].values.astype(np.float32)\nfb_ay = df_fb['acc_y_mps2'].values.astype(np.float32)\nfb_az = df_fb['acc_z_mps2'].values.astype(np.float32)\nfb_gz = df_fb['gyro_z_rads'].values.astype(np.float32)\nfb_gx = np.zeros_like(fb_gz)\nfb_gy = np.zeros_like(fb_gz)\n\nfb_feats = np.column_stack([fb_ax, fb_ay, fb_az, fb_gx, fb_gy, fb_gz])\nfb_windows = [fb_feats[i : i + win] for i in range(0, len(fb_feats) - win, step)]\n\n# --- B. RoNiN (Multi-Subject Benchmark Walking) ---\nronin_csv = find_input_file('ronin')\nprint(f\"Loading RoNiN Data: {ronin_csv}\")\ndf_ronin = pd.read_csv(ronin_csv)\n\nr_feats = df_ronin[['ax', 'ay', 'az', 'gx', 'gy', 'gz']].values.astype(np.float32)\nronin_windows = [r_feats[i : i + win] for i in range(0, len(r_feats) - win, step)]\n\n# --- C. Exact 70% ForestBack + 30% RoNiN Blend ---\n# Match target walking samples to balance with vehicle classes\ntarget_walk_windows = min(len(fb_windows), len(ronin_windows) * 2, 4000)\n\nnum_fb = int(target_walk_windows * 0.70)      # 70% ForestBack\nnum_ronin = int(target_walk_windows * 0.30)   # 30% RoNiN\n\nnp.random.seed(42)\nselected_fb_idx = np.random.choice(len(fb_windows), num_fb, replace=False)\nselected_ronin_idx = np.random.choice(len(ronin_windows), num_ronin, replace=False)\n\nfor idx in selected_fb_idx:\n    X_samples.append(fb_windows[idx])\n    y_labels.append(3)  # Class 3: Walking\n\nfor idx in selected_ronin_idx:\n    X_samples.append(ronin_windows[idx])\n    y_labels.append(3)  # Class 3: Walking\n\nprint(f\"\\n=======================================================\")\nprint(f\"🚶 WALKING DATASET COMPOSITION (Class 3):\")\nprint(f\"   • ForestBack (Forest Walking) : {num_fb:,} windows ({num_fb/target_walk_windows*100:.1f}%)\")\nprint(f\"   • RoNiN (Academic Benchmark)  : {num_ronin:,} windows ({num_ronin/target_walk_windows*100:.1f}%)\")\nprint(f\"   • Total Walking Windows       : {target_walk_windows:,} (100% Real Sensor Data)\")\nprint(f\"=======================================================\\n\")\n\n# =============================================================\n# 3. PREPARE TRAINING & TESTING LOADERS\n# =============================================================\nX_arr = np.array(X_samples, dtype=np.float32)\ny_arr = np.array(y_labels, dtype=np.int64)\n\n# 80/20 Train-Test split\nidx = np.random.permutation(len(y_arr))\nsplit = int(0.8 * len(y_arr))\nX_train, y_train = X_arr[idx[:split]], y_arr[idx[:split]]\nX_test, y_test = X_arr[idx[split:]], y_arr[idx[split:]]\n\ntrain_loader = DataLoader(\n    list(zip(torch.from_numpy(X_train), torch.from_numpy(y_train))), \n    batch_size=128, \n    shuffle=True\n)\n\nprint(f\"📊 OVERALL CLASS BALANCE:\")\nfor c_idx, c_name in enumerate(CLASS_NAMES):\n    print(f\"   Class {c_idx} [{c_name:<16}]: {np.sum(y_arr == c_idx):,} windows\")\nprint(f\"   Train: {len(X_train):,} | Test: {len(X_test):,}\\n\")\n\n# =============================================================\n# 4. GRU ARCHITECTURE & TRAINING LOOP\n# =============================================================\nclass MotionClassifierGRU(nn.Module):\n    def __init__(self, in_features=6, hidden_dim=64, num_layers=2, num_classes=4, dropout=0.2):\n        super().__init__()\n        self.gru = nn.GRU(\n            in_features, \n            hidden_dim, \n            num_layers=num_layers, \n            batch_first=True, \n            dropout=dropout if num_layers > 1 else 0.0\n        )\n        self.classifier = nn.Sequential(\n            nn.Linear(hidden_dim, 32),\n            nn.ReLU(),\n            nn.Dropout(dropout),\n            nn.Linear(32, num_classes)\n        )\n\n    def forward(self, x):\n        out, _ = self.gru(x)\n        last_step = out[:, -1, :]\n        return self.classifier(last_step)\n\nmodel_gru = MotionClassifierGRU(num_classes=4).to(device)\ncriterion = nn.CrossEntropyLoss()\noptimizer = torch.optim.AdamW(model_gru.parameters(), lr=1e-3, weight_decay=1e-4)\n\nepochs = 10\nprint(f\"🚀 Training GRU on Scooter + 70% ForestBack + 30% RoNiN ({epochs} epochs)...\\n\")\n\nfor epoch in range(1, epochs + 1):\n    model_gru.train()\n    total_loss, correct = 0.0, 0\n    for xb, yb in train_loader:\n        xb, yb = xb.to(device), yb.to(device)\n        optimizer.zero_grad()\n        out = model_gru(xb)\n        loss = criterion(out, yb)\n        loss.backward()\n        optimizer.step()\n        \n        total_loss += loss.item() * len(yb)\n        preds = torch.argmax(out, dim=1)\n        correct += (preds == yb).sum().item()\n        \n    acc = correct / len(X_train) * 100.0\n    print(f\"Epoch [{epoch:02d}/{epochs:02d}] ── Loss: {total_loss / len(X_train):.4f} | Accuracy: {acc:.2f}%\")\n\n# =============================================================\n# 5. EVALUATION REPORT & CONFUSION MATRIX\n# =============================================================\nmodel_gru.eval()\nwith torch.no_grad():\n    test_out = model_gru(torch.from_numpy(X_test).to(device))\n    test_preds = torch.argmax(test_out, dim=1).cpu().numpy()\n\noverall_acc = accuracy_score(y_test, test_preds) * 100.0\n\nprint(\"\\n\" + \"=\"*60)\nprint(f\"      MOTION CLASSIFIER (GRU) — EVALUATION REPORT\")\nprint(\"=\"*60)\nprint(f\"Overall Accuracy: {overall_acc:.2f}%\\n\")\nprint(classification_report(y_test, test_preds, target_names=CLASS_NAMES, digits=4))\n\n# Confusion Matrix\ncm = confusion_matrix(y_test, test_preds)\nprint(\"Confusion Matrix:\")\nprint(\"          \" + \"  \".join([f\"{name[:8]:>8}\" for name in CLASS_NAMES]))\nfor i, row in enumerate(cm):\n    print(f\"{CLASS_NAMES[i][:8]:>8}  \" + \"  \".join([f\"{val:>8d}\" for val in row]))\nprint(\"=\"*60 + \"\\n\")\n\n# =============================================================\n# 6. EXPORT STANDALONE ONNX FOR EDGE DEPLOYMENT\n# =============================================================\nonnx_path = \"/kaggle/working/motion_classifier.onnx\"\npth_path = \"/kaggle/working/motion_classifier.pth\"\n\ntorch.save(model_gru.state_dict(), pth_path)\n\ndummy_input = torch.randn(1, 100, 6, device=device)\ntorch.onnx.export(\n    model_gru,\n    dummy_input,\n    onnx_path,\n    input_names=[\"imu_sequence\"],\n    output_names=[\"motion_logits\"],\n    dynamic_axes={\"imu_sequence\": {0: \"batch_size\"}},\n    opset_version=14,\n    dynamo=False\n)\n\nprint(f\"✅ Saved PyTorch model: {pth_path}\")\nprint(f\"✅ Exported ONNX classifier: {onnx_path} ({os.path.getsize(onnx_path)/1024:.1f} KB)\\n\")\n\nprint(\"Click below to download your Motion Classifier:\")\ndisplay(FileLink('motion_classifier.onnx'))\ndisplay(FileLink('motion_classifier.pth'))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-03T06:56:18.0521Z","iopub.execute_input":"2026-10-03T06:56:18.052461Z","iopub.status.idle":"2026-10-03T06:56:26.654602Z","shell.execute_reply.started":"2026-10-03T06:56:18.052436Z","shell.execute_reply":"2026-10-03T06:56:26.65387Z"}},"outputs":[{"name":"stdout","text":"✅ Active compute device: cuda\nLoading Vehicle Telematics: /kaggle/input/datasets/subhashb21022/scooter-test-data/scooter_test_all_100hz.csv\nExtracted 19,919 vehicle and stationary windows.\nLoading ForestBack Data: /kaggle/input/datasets/subhashb21022/forestback-indoor-pdr-dataset/forestback_indoor_pdr_dataset.csv\nLoading RoNiN Data: /kaggle/input/datasets/subhashb21022/ronin-walking-sample/ronin_walking_sample_100hz.csv\n\n=======================================================\n🚶 WALKING DATASET COMPOSITION (Class 3):\n   • ForestBack (Forest Walking) : 1,483 windows (70.0%)\n   • RoNiN (Academic Benchmark)  : 635 windows (30.0%)\n   • Total Walking Windows       : 2,119 (100% Real Sensor Data)\n=======================================================\n\n📊 OVERALL CLASS BALANCE:\n   Class 0 [Stationary      ]: 1,290 windows\n   Class 1 [Vehicle_Cruising]: 872 windows\n   Class 2 [Vehicle_Turning ]: 17,757 windows\n   Class 3 [Walking         ]: 2,118 windows\n   Train: 17,629 | Test: 4,408\n\n🚀 Training GRU on