m.\u001b[0m\u001b[0m_getitem_multilevel\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mkey\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 4113\u001b[0;31m             \u001b[0mindexer\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mcolumns\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mget_loc\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mkey\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   4114\u001b[0m             \u001b[0;32mif\u001b[0m \u001b[0mis_integer\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mindexer\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   4115\u001b[0m                 \u001b[0mindexer\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0;34m[\u001b[0m\u001b[0mindexer\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/pandas/core/indexes/base.py\u001b[0m in \u001b[0;36mget_loc\u001b[0;34m(self, key)\u001b[0m\n\u001b[1;32m   3817\u001b[0m             ):\n\u001b[1;32m   3818\u001b[0m                 \u001b[0;32mraise\u001b[0m \u001b[0mInvalidIndexError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mkey\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 3819\u001b[0;31m             \u001b[0;32mraise\u001b[0m \u001b[0mKeyError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mkey\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;32mfrom\u001b[0m \u001b[0merr\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   3820\u001b[0m         \u001b[0;32mexcept\u001b[0m \u001b[0mTypeError\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   3821\u001b[0m             \u001b[0;31m# If we have a listlike key, _check_indexing_error will raise\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mKeyError\u001b[0m: 'speed_mps'"],"ename":"KeyError","evalue":"'speed_mps'","output_type":"error"}],"execution_count":15},{"cell_type":"code","source":"import os\nimport glob\nimport time\nimport base64\nimport numpy as np\nimport pandas as pd\nfrom scipy.signal import find_peaks\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom IPython.display import HTML, display\n\n# ==============================================================================\n# 1. COMPUTE HARDWARE SETUP\n# ==============================================================================\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"✅ Active compute device: {device}\")\nif torch.cuda.is_available():\n    print(f\"   GPU: {torch.cuda.get_device_name(0)}\")\n\n# ==============================================================================\n# 2. LOCATE DATASETS (70% ForestBack + 30% RoNiN)\n# ==============================================================================\ndef find_file(pattern, fallback):\n    matches = glob.glob(pattern, recursive=True)\n    if matches:\n        return matches[0]\n    return fallback\n\nfb_path = find_file(\"/kaggle/input/**/forestback_indoor_pdr_dataset.csv\",\n                    \"/kaggle/input/datasets/subhashb21022/forestback-indoor-pdr-dataset/forestback_indoor_pdr_dataset.csv\")\nronin_path = find_file(\"/kaggle/input/**/ronin_walking_sample_100hz.csv\",\n                       \"/kaggle/input/datasets/subhashb21022/ronin-walking-sample/ronin_walking_sample_100hz.csv\")\n\nprint(f\"📂 ForestBack Data: {fb_path}\")\nprint(f\"📂 RoNiN Data     : {ronin_path}\")\n\ndf_fb = pd.read_csv(fb_path)\ndf_ronin = pd.read_csv(ronin_path)\n\n# ==============================================================================\n# 3. CONSTRUCT 70/30 PEDESTRIAN VELOCITY WINDOWS\n# ==============================================================================\nwin = 100 # 1.0 second window at 100 Hz\nstep = 25 # 4 Hz stride\n\n# A. ForestBack Data Extraction (70%)\n# Derive continuous walking speed from adaptive step length * step frequency\nfb_acc = df_fb[['acc_x_mps2', 'acc_y_mps2', 'acc_z_mps2']].values.astype(np.float32)\nfb_gz = df_fb['gyro_z_rads'].values.astype(np.float32)\nfb_imu = np.column_stack([fb_acc, np.zeros_like(fb_gz), np.zeros_like(fb_gz), fb_gz]) # 6-axis\n\nfb_speed = (df_fb['adaptive_step_length_m'].fillna(0.65) * df_fb['step_frequency_hz'].fillna(1.8)).values.astype(np.float32)\nfb_speed[df_fb['step_frequency_hz'] < 0.2] = 0.0\n\nfb_X, fb_y = [], []\nfor i in range(0, len(fb_imu) - win, step):\n    fb_X.append(fb_imu[i : i + win])\n    fb_y.append(fb_speed[i + win - 1])\n\n# B. RoNiN Benchmark Data Extraction (30%)\n# Derive continuous walking speed from heel-strike cadence & Weinberg stride\nr_imu = df_ronin[['ax', 'ay', 'az', 'gx', 'gy', 'gz']].values.astype(np.float32)\nr_amag = np.sqrt(r_imu[:, 0]**2 + r_imu[:, 1]**2 + r_imu[:, 2]**2)\n\nr_X, r_y = [], []\nfor i in range(0, len(r_imu) - win, step):\n    w_a = r_amag[i : i + win]\n    peaks, _ = find_peaks(w_a - 9.81, height=0.6, distance=30)\n    delta_a = max(0.1, max(w_a) - min(w_a))\n    step_len = 0.42 * (delta_a ** 0.25)\n    v_speed = float(len(peaks) * step_len) # instantaneous speed in m/s\n    r_X.append(r_imu[i : i + win])\n    r_y.append(v_speed)\n\n# Blend: exactly 70% ForestBack + 30% RoNiN\nn_ronin = len(r_X)\nn_fb_target = int(n_ronin * (70.0 / 30.0))\nn_fb = min(len(fb_X), n_fb_target)\n\nfb_X, fb_y = fb_X[:n_fb], fb_y[:n_fb]\nn_r_target = int(len(fb_X) * (30.0 / 70.0))\nr_X, r_y = r_X[:n_r_target], r_y[:n_r_target]\n\ntotal_X = np.array(fb_X + r_X, dtype=np.float32).transpose(0, 2, 1) # (N, 6, 100)\ntotal_y = np.array(fb_y + r_y, dtype=np.float32)[:, np.newaxis]      # (N, 1)\n\nprint(\"\\n\" + \"=\" * 60)\nprint(f\"🚶 PEDESTRIAN DATA COMPOSITION:\")\nprint(f\"   • ForestBack (Indoor PDR) : {len(fb_X):,} windows ({len(fb_X)/len(total_X)*100:.1f}%)\")\nprint(f\"   • RoNiN (Academic Bench)  : {len(r_X):,} windows ({len(r_X)/len(total_X)*100:.1f}%)\")\nprint(f\"   • Total Training Windows  : {len(total_X):,}\")\nprint(\"=\" * 60)\n\n# Train/Test Split (80/20)\nindices = np.arange(len(total_X))\nnp.random.seed(42)\nnp.random.shuffle(indices)\nsplit_idx = int(0.80 * len(total_X))\n\ntrain_idx, test_idx = indices[:split_idx], indices[split_idx:]\nX_train, y_train = total_X[train_idx], total_y[train_idx]\nX_test, y_test = total_X[test_idx], total_y[test_idx]\n\nclass WalkDataset(Dataset):\n    def __init__(self, X, y):\n        self.X = torch.tensor(X, dtype=torch.float32)\n        self.y = torch.tensor(y, dtype=torch.float32)\n    def __len__(self):\n        return len(self.X)\n    def __getitem__(self, idx):\n        return self.X[idx], self.y[idx]\n\ntrain_loader = DataLoader(WalkDataset(X_train, y_train), batch_size=128, shuffle=True)\ntest_loader = DataLoader(WalkDataset(X_test, y_test), batch_size=256, shuffle=False)\n\n# ==============================================================================\n# 4. DEEP PDR 1D-TCN MODEL\n# ==============================================================================\nclass PedestrianSpeedEstimator(nn.Module):\n    def __init__(self, in_channels=6):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv1d(in_channels, 32, kernel_size=3, padding=1),\n            nn.BatchNorm1d(32),\n            nn.ReLU(),\n            nn.Conv1d(32, 64, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(64),\n            nn.ReLU(),\n            nn.Conv1d(64, 128, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(128),\n            nn.ReLU(),\n            nn.AdaptiveAvgPool1d(1),\n            nn.Flatten(),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = PedestrianSpeedEstimator().to(device)\ncriterion = nn.HuberLoss(delta=0.5)\noptimizer = torch.optim.AdamW(model.parameters(), lr=1e-3, weight_decay=1e-4)\nscheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=10)\n\n# ==============================================================================\n# 5. TRAINING LOOP (10 EPOCHS)\n# ==============================================================================\nprint(\"\\n🚀 Training Deep PDR Walking Speed Estimator (10 Epochs)...\")\nepochs = 10\n\nfor epoch in range(1, epochs + 1):\n    model.train()\n    running_loss, running_mae = 0.0, 0.0\n    for bx, by in train_loader:\n        bx, by = bx.to(device), by.to(device)\n        optimizer.zero_grad()\n        preds = torch.clamp(model(bx), min=0.0)\n        loss = criterion(preds, by)\n        loss.backward()\n        optimizer.step()\n        running_loss += loss.item() * len(by)\n        running_mae += torch.sum(torch.abs(preds - by)).item()\n        \n    scheduler.step()\n    ep_loss = running_loss / len(X_train)\n    ep_mae_mps = running_mae / len(X_train)\n    print(f\"Epoch [{epoch:02d}/{epochs:02d}] ── Loss: {ep_loss:.4f} | Walking Speed MAE: {ep_mae_mps:.3f} m/s ({ep_mae_mps*3.6:.2f} km/h)\")\n\n# ==============================================================================\n# 6. EVALUATION ON UNSEEN WALKING SEQUENCES\n# ==============================================================================\nmodel.eval()\nall_preds, all_gt = [], []\nwith torch.no_grad():\n    for bx, by in test_loader:\n        bx = bx.to(device)\n        preds = model(bx).cpu().numpy().flatten()\n        preds = np.maximum(0.0, preds)\n        all_preds.extend(preds)\n        all_gt.extend(by.numpy().flatten())\n\nall_preds = np.array(all_preds)\nall_gt = np.array(all_gt)\n\nmae_mps = np.mean(np.abs(all_preds - all_gt))\nrmse_mps = np.sqrt(np.mean((all_preds - all_gt)**2))\ncorr = np.corrcoef(all_preds, all_gt)[0, 1]\n\nprint(\"\\n\" + \"=\" * 65)\nprint(\"  DEEP PDR WALKING ESTIMATOR (1D-TCN) — EVALUATION REPORT\")\nprint(\"=\" * 65)\nprint(f\"• Walking Speed MAE   : {mae_mps:.3f} m/s ({mae_mps * 3.6:.2f} km/h)\")\nprint(f\"• Walking Speed RMSE  : {rmse_mps:.3f} m/s ({rmse_mps * 3.6:.2f} km/h)\")\nprint(f\"• Correlation (r)     : {corr:.4f}\")\nprint(f\"• Typical Human Walk  : 1.20 - 1.40 m/s\")\nprint(\"=\" * 65)\n\n# ==============================================================================\n# 7. EXPORT STANDALONE ONNX & PYTORCH CHECKPOINTS\n# ==============================================================================\npth_path = \"/kaggle/working/pedestrian_speed_estimator.pth\"\nonnx_path = \"/kaggle/working/pedestrian_speed_estimator.onnx\"\n\ntorch.save(model.state_dict(), pth_path)\nprint(f\"\\n✅ Saved PyTorch model: {pth_path}\")\n\ndummy_input = torch.randn(1, 6, 100, device=device)\ntorch.onnx.export(\n    model,\n    dummy_input,\n    onnx_path,\n    input_names=[\"imu_window\"],\n    output_names=[\"speed_mps\"],\n    dynamic_axes={\"imu_window\": {0: \"batch_size\"}, \"speed_mps\": {0: \"batch_size\"}},\n    opset_version=14,\n    dynamo=False,\n)\nonnx_size_kb = os.path.getsize(onnx_path) / 1024\nprint(f\"✅ Exported standalone ONNX model: {onnx_path} ({onnx_size_kb:.1f} KB)\")\n\n# Direct Browser Download Link (No 404 error)\ndef get_binary_download_link(file_path):\n    with open(file_path, \"rb\") as f:\n        b64 = base64.b64encode(f.read()).decode()\n    filename = file_path.split(\"/\")[-1]\n    return f'''\n    <a download=\"{filename}\" href=\"data:application/octet-stream;base64,{b64}\" \n       style=\"display:inline-block; padding:10px 18px; margin:8px 0; background-color:#10b981; color:white; font-weight:bold; border-radius:6px; text-decoration:none;\">\n       📥 Download {filename}\n    </a>\n    '''\n\ndisplay(HTML(f\"<h3>Click to download Deep PDR Model:</h3>\" +\n             get_binary_download_link(onnx_path) + \"<br>\" +\n             get_binary_download_link(pth_path)))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-03T06:57:05.427567Z","iopub.exe