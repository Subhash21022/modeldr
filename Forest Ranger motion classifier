l/lib/python3.13/dist-packages/torch/onnx/_internal/torchscript_exporter/symbolic_opset9.py:4571: UserWarning: Exporting a model to ONNX with a batch_size other than 1, with a variable length with GRU can cause an error when running the ONNX model with a different batch size. Make sure to save the model with a batch size of 1, or define the initial states (h0/c0) as inputs of the model. \n  return _generic_rnn(\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"/kaggle/working/motion_classifier.onnx","text/html":"<a href='motion_classifier.onnx' target='_blank'>motion_classifier.onnx</a><br>"},"metadata":{}}],"execution_count":12},{"cell_type":"code","source":"import os\nimport glob\nimport time\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom IPython.display import HTML, display\n\n# ==============================================================================\n# 1. HARDWARE ACCELERATION SETUP\n# ==============================================================================\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"✅ Active compute device: {device}\")\nif torch.cuda.is_available():\n    print(f\"   GPU: {torch.cuda.get_device_name(0)}\")\n\n# ==============================================================================\n# 2. LOCATE SCOOTER TELEMATICS DATASET\n# ==============================================================================\npossible_paths = [\n    \"/kaggle/input/datasets/subhashb21022/scooter-test-data/scooter_test_all_100hz.csv\",\n    \"/kaggle/input/scooter-test-data/scooter_test_all_100hz.csv\",\n]\nfound_csv = None\nfor p in possible_paths:\n    if os.path.exists(p):\n        found_csv = p\n        break\n\nif not found_csv:\n    matches = glob.glob(\"/kaggle/input/**/scooter_test_all_100hz.csv\", recursive=True)\n    if matches:\n        found_csv = matches[0]\n\nif not found_csv:\n    raise FileNotFoundError(\"Could not find 'scooter_test_all_100hz.csv' in /kaggle/input/. Please check your dataset attachment.\")\n\nprint(f\"📂 Loading Scooter Dataset: {found_csv}\")\ndf = pd.read_csv(found_csv)\nprint(f\"   Total Samples: {len(df):,} rows (~{len(df)/100/60:.1f} minutes of 100 Hz riding)\")\n\n# ==============================================================================\n# 3. TRAIN / TEST SPLIT (HELD-OUT REAL-WORLD TRIPS)\n# ==============================================================================\n# Strictly hold out dataset_3, dataset_6, dataset_8 (West Mambalam & Guindy interior routes)\nheldout_trips = ['dataset_3', 'dataset_6', 'dataset_8']\ndf_train = df[~df['dataset_id'].isin(heldout_trips)].reset_index(drop=True)\ndf_test = df[df['dataset_id'].isin(heldout_trips)].reset_index(drop=True)\n\nprint(f\"📊 Dataset Split:\")\nprint(f\"   • Training Runs : {len(df_train):,} samples (~{len(df_train)/100/60:.1f} mins)\")\nprint(f\"   • Held-Out Test : {len(df_test):,} samples (~{len(df_test)/100/60:.1f} mins) [Routes: {heldout_trips}]\")\n\n# ==============================================================================\n# 4. SLIDING WINDOW EXTRACTION\n# ==============================================================================\ndef create_windows(df_subset, win=100, step=10):\n    feats = df_subset[['ax', 'ay', 'az', 'gx', 'gy', 'gz']].values.astype(np.float32)\n    speeds = df_subset['speed_mps'].values.astype(np.float32)\n    \n    X, y = [], []\n    for i in range(0, len(feats) - win, step):\n        X.append(feats[i : i + win])\n        y.append(speeds[i + win - 1])\n        \n    X_arr = np.array(X, dtype=np.float32).transpose(0, 2, 1) # Shape: (N, 6, 100)\n    y_arr = np.array(y, dtype=np.float32)[:, np.newaxis]      # Shape: (N, 1)\n    return X_arr, y_arr\n\nprint(\"\\n⏳ Extracting 1.0-second sliding windows (100 samples)...\")\nX_train, y_train = create_windows(df_train, win=100, step=10) # 10 Hz stride for dense training\nX_test, y_test = create_windows(df_test, win=100, step=50)   # 2 Hz stride for held-out evaluation\n\nprint(f\"   • Training Windows : {len(X_train):,}\")\nprint(f\"   • Test Windows     : {len(X_test):,}\")\n\nclass IMUSpeedDataset(Dataset):\n    def __init__(self, X, y):\n        self.X = torch.tensor(X, dtype=torch.float32)\n        self.y = torch.tensor(y, dtype=torch.float32)\n    def __len__(self):\n        return len(self.X)\n    def __getitem__(self, idx):\n        return self.X[idx], self.y[idx]\n\ntrain_loader = DataLoader(IMUSpeedDataset(X_train, y_train), batch_size=256, shuffle=True)\ntest_loader = DataLoader(IMUSpeedDataset(X_test, y_test), batch_size=512, shuffle=False)\n\n# ==============================================================================\n# 5. 1D TEMPORAL CONVOLUTIONAL NETWORK (TCN) ARCHITECTURE\n# ==============================================================================\nclass UniversalSpeedEstimator(nn.Module):\n    \"\"\"\n    1D-TCN Speed Estimator:\n    Input: (B, 6, 100) -> [ax, ay, az, gx, gy, gz]\n    Output: (B, 1) -> Forward Speed (m/s)\n    \"\"\"\n    def __init__(self, in_channels=6):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv1d(in_channels, 32, kernel_size=3, padding=1),\n            nn.BatchNorm1d(32),\n            nn.ReLU(),\n            nn.Conv1d(32, 64, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(64),\n            nn.ReLU(),\n            nn.Conv1d(64, 128, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(128),\n            nn.ReLU(),\n            nn.AdaptiveAvgPool1d(1),\n            nn.Flatten(),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = UniversalSpeedEstimator().to(device)\nhuber_loss = nn.HuberLoss(delta=1.0)\nmse_loss = nn.MSELoss()\n\noptimizer = torch.optim.AdamW(model.parameters(), lr=1e-3, weight_decay=1e-4)\nscheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=12)\n\n# ==============================================================================\n# 6. DUAL-OBJECTIVE TRAINING LOOP (12 EPOCHS)\n# ==============================================================================\nprint(\"\\n🚀 Training Scooter Speed Estimator (12 Epochs)...\")\nepochs = 12\n\nfor epoch in range(1, epochs + 1):\n    model.train()\n    total_loss, total_mae = 0.0, 0.0\n    \n    for batch_x, batch_y in train_loader:\n        batch_x, batch_y = batch_x.to(device), batch_y.to(device)\n        optimizer.zero_grad()\n        \n        preds = model(batch_x)\n        preds = torch.clamp(preds, min=0.0)\n        \n        # 1. Main Speed Loss\n        loss_speed = huber_loss(preds, batch_y)\n        \n        # 2. Idle Vibration Penalty: Heavily penalize any speed > 0 when stopped\n        stationary_mask = (batch_y < 0.5) # < 1.8 km/h\n        if stationary_mask.sum() > 0:\n            loss_zupt = mse_loss(preds[stationary_mask], batch_y[stationary_mask])\n        else:\n            loss_zupt = 0.0\n            \n        loss = loss_speed + 2.5 * loss_zupt\n        loss.backward()\n        optimizer.step()\n        \n        total_loss += loss.item() * len(batch_y)\n        total_mae += torch.sum(torch.abs(preds - batch_y)).item()\n        \n    scheduler.step()\n    \n    epoch_loss = total_loss / len(X_train)\n    epoch_mae_kmh = (total_mae / len(X_train)) * 3.6\n    print(f\"Epoch [{epoch:02d}/{epochs:02d}] ── Loss: {epoch_loss:.4f} | Train Speed MAE: {epoch_mae_kmh:.2f} km/h\")\n\n# ==============================================================================\n# 7. RIGOROUS EVALUATION ON UNSEEN HELD-OUT ROUTES\n# ==============================================================================\nmodel.eval()\nall_preds, all_gt = [], []\n\nwith torch.no_grad():\n    for batch_x, batch_y in test_loader:\n        batch_x = batch_x.to(device)\n        preds = model(batch_x).cpu().numpy().flatten()\n        preds = np.maximum(0.0, preds)\n        all_preds.extend(preds)\n        all_gt.extend(batch_y.numpy().flatten())\n\nall_preds_kmh = np.array(all_preds) * 3.6\nall_gt_kmh = np.array(all_gt) * 3.6\n\nmae_overall = np.mean(np.abs(all_preds_kmh - all_gt_kmh))\nrmse_overall = np.sqrt(np.mean((all_preds_kmh - all_gt_kmh)**2))\ncorr = np.corrcoef(all_preds_kmh, all_gt_kmh)[0, 1]\n\n# Stationary idle performance\nstat_mask = (all_gt_kmh < 1.5)\nstat_mae = np.mean(all_preds_kmh[stat_mask]) if np.sum(stat_mask) > 0 else 0.0\n\n# Cruising performance (> 15 km/h)\ncruise_mask = (all_gt_kmh >= 15.0)\ncruise_mae = np.mean(np.abs(all_preds_kmh[cruise_mask] - all_gt_kmh[cruise_mask])) if np.sum(cruise_mask) > 0 else 0.0\n\nprint(\"\\n\" + \"=\" * 65)\nprint(\"  SCOOTER SPEED ESTIMATOR (1D-TCN) — EVALUATION REPORT\")\nprint(\"=\" * 65)\nprint(f\"• Overall Speed MAE       : {mae_overall:.2f} km/h\")\nprint(f\"• Overall Speed RMSE      : {rmse_overall:.2f} km/h\")\nprint(f\"• Correlation (r)         : {corr:.4f}\")\nprint(f\"• Engine Idle Error (0 km/h): {stat_mae:.2f} km/h (Target: < 2.0 km/h)\")\nprint(f\"• Cruising Speed MAE      : {cruise_mae:.2f} km/h\")\nprint(\"=\" * 65)\n\n# ==============================================================================\n# 8. EXPORT STANDALONE PYTORCH & ONNX MODELS\n# ==============================================================================\npth_path = \"/kaggle/working/universal_speed_estimator.pth\"\nonnx_path = \"/kaggle/working/universal_speed_estimator.onnx\"\n\ntorch.save(model.state_dict(), pth_path)\nprint(f\"\\n✅ Saved PyTorch model: {pth_path}\")\n\ndummy_input = torch.randn(1, 6, 100, device=device)\nmodel.eval()\n\ntorch.onnx.export(\n    model,\n    dummy_input,\n    onnx_path,\n    input_names=[\"imu_window\"],\n    output_names=[\"speed_mps\"],\n    dynamic_axes={\"imu_window\": {0: \"batch_size\"}, \"speed_mps\": {0: \"batch_size\"}},\n    opset_version=14,\n    dynamo=False,\n)\nonnx_size_kb = os.path.get