vice:\", device)\n\nCLASS_NAMES = ['Stationary', 'Vehicle_Cruising', 'Vehicle_Turning', 'Walking']\nwin = 100  # 1-second window at 100 Hz\nstep = 20\n\n# Helper to find files dynamically in /kaggle/input\ndef find_input_file(keyword):\n    for root, _, files in os.walk('/kaggle/input'):\n        for f in files:\n            if keyword.lower() in f.lower() and f.endswith('.csv'):\n                return os.path.join(root, f)\n    raise FileNotFoundError(f\"Could not find dataset file matching '{keyword}' in /kaggle/input\")\n\n# =============================================================\n# 1. LOAD VEHICLE & STATIONARY DATA (SCOOTER)\n# =============================================================\nscooter_csv = find_input_file('scooter')\nprint(f\"Loading Vehicle Telematics: {scooter_csv}\")\ndf_scooter = pd.read_csv(scooter_csv)\n\ns_feats = df_scooter[['ax', 'ay', 'az', 'gx', 'gy', 'gz']].values.astype(np.float32)\ns_speeds = df_scooter['speed_kmh'].values.astype(np.float32)\ns_gz = df_scooter['gz'].values.astype(np.float32)\n\nX_samples, y_labels = [], []\n\nfor i in range(0, len(s_feats) - win, step):\n    w_feat = s_feats[i : i + win]\n    w_speed = np.mean(s_speeds[i : i + win])\n    w_gz_max = np.max(np.abs(s_gz[i : i + win]))\n    \n    if w_speed < 1.0:\n        label = 0  # Stationary\n    elif w_speed >= 6.0 and w_gz_max > 0.38:\n        label = 2  # Vehicle Turning\n    elif w_speed >= 8.0 and w_gz_max <= 0.38:\n        label = 1  # Vehicle Cruising\n    else:\n        continue\n        \n    X_samples.append(w_feat)\n    y_labels.append(label)\n\nprint(f\"Extracted {len(X_samples):,} vehicle and stationary windows.\")\n\n# =============================================================\n# 2. LOAD & BLEND WALKING DATA (70% ForestBack + 30% RoNiN)\n# =============================================================\n# --- A. ForestBack (Forest Terrain Walking) ---\nfb_csv = find_input_file('forestback')\nprint(f\"Loading ForestBack Data: {fb_csv}\")\ndf_fb =