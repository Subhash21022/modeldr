===================================================\n\n✅ Saved PyTorch model: /kaggle/working/pedestrian_speed_estimator.pth\n✅ Exported standalone ONNX model: /kaggle/working/pedestrian_speed_estimator.onnx (157.4 KB)\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_48/3197548849.py:210: DeprecationWarning: You are using the legacy TorchScript-based ONNX export. Starting in PyTorch 2.9, the new torch.export-based ONNX exporter has become the default. Learn more about the new export logic: https://docs.pytorch.org/docs/stable/onnx_export.html. For exporting control flow: https://pytorch.org/tutorials/beginner/onnx/export_control_flow_model_to_onnx_tutorial.html\n  torch.onnx.export(\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.HTML object>","text/html":"<h3>Click to download Deep PDR Model:</h3>\n    <a download=\"pedestrian_speed_estimator.onnx\" href=\"data:application/octet-stream;base64,\" \n       style=\"display:inline-block; padding:10px 18px; margin:8px 0; background-color:#10b981; color:white; font-weight:bold; border-radius:6px; text-decoration:none;\">\n       📥 Download pedestrian_speed_estimator.onnx\n    </a>\n    <br>\n    <a download=\"pedestrian_speed_estimator.pth\" href=\"data:application/octet-stream;base64,\" \n       style=\"display:inline-block; padding:10px 18px; margin:8px 0; background-color:#10b981; color:white; font-weight:bold; border-radius:6px; text-decoration:none;\">\n       📥 Download pedestrian_speed_estimator.pth\n    </a>\n    "},"metadata":{}}],"execution_count":16},{"cell_type":"code","source":"import os\nimport glob\nimport time\nimport numpy as np\nimport pandas as pd\nfrom collections import deque\nfrom dataclasses import dataclass\nfrom enum import Enum\nfrom typing import Optional, Tuple, List, Dict, Any\nfrom scipy.signal import find_peaks\nimport onnxruntime as ort\nimport matplotlib.pyplot as plt\n\nR_EARTH = 6378137.0  # WGS-84 Earth Radius in meters\n\ndef haversine_m(lat1: float, lon1: float, lat2: float, lon2: float) -> float:\n    phi1, phi2 = np.radians(lat1), np.radians(lat2)\n    dphi = np.radians(lat2 - lat1)\n    dlam = np.radians(lon2 - lon1)\n    a = np.sin(dphi / 2.0)**2 + np.cos(phi1) * np.cos(phi2) * np.sin(dlam / 2.0)**2\n    return float(2.0 * R_EARTH * np.arctan2(np.sqrt(a), np.sqrt(1.0 - a)))\n\n# ==============================================================================\n# MODULE 1: SENSOR PREPROCESSOR\n# ==============================================================================\n@dataclass\nclass ProcessedSample:\n    timestamp_s: float\n    dt: float\n    ax: float; ay: float; az: float\n    gx: float; gy: float; gz: float\n    lat: Optional[float] = None\n    lon: Optional[float] = None\n    gnss_speed_mps: Optional[float] = None\n    gnss_accuracy_m: Optional[float] = None\n    gnss_bearing_deg: Optional[float] = None\n\nclass SensorPreprocessor:\n    \"\"\"Handles unit normalization, spike rejection, and 1.0s sliding ring buffering.\"\"\"\n    def __init__(self, target_freq_hz: float = 100.0, window_size: int = 100):\n        self.target_freq = target_freq_hz\n        self.nominal_dt = 1.0 / target_freq_hz\n        self.window_size = window_size\n        self.last_timestamp: Optional[float] = None\n        self.buffer = deque(maxlen=window_size)\n\n    def add_sample(self, timestamp_s, ax, ay, az, gx, gy, gz, lat=None, lon=None, speed=None, acc=None, bearing=None):\n        if self.last_timestamp is None:\n            dt = self.nominal_dt\n        else:\n            raw_dt = timestamp_s - self.last_timestamp\n            dt = raw_dt if (0.001 <= raw_dt <= 0.2) else self.nominal_dt\n        self.last_timestamp = timestamp_s\n\n        # Spike rejection: clamp accelerometer norm to physical envelope\n        acc_vec = np.array([ax, ay, az], dtype=np.float32)\n        if np.linalg.norm(acc_vec) > 55.0:\n            acc_vec = acc_vec / np.linalg.norm(acc_vec) * 9.81\n\n        feat = np.array([acc_vec[0], acc_vec[1], acc_vec[2], gx, gy, gz], dtype=np.float32)\n        self.buffer.append(feat)\n\n        return ProcessedSample(timestamp_s, dt, acc_vec[0], acc_vec[1], acc_vec[2], gx, gy, gz, lat, lon, speed, acc, bearing)\n\n    def is_ready(self) -> bool:\n        return len(self.buffer) == self.window_size\n\n    def get_classifier_window(self) -> np.ndarray:\n        return np.array(self.buffer, dtype=np.float32)[np.newaxis, :, :] # (1, 100, 6)\n\n    def get_tcn_window(self) -> np.ndarray:\n        return np.array(self.buffer, dtype=np.float32).T[np.newaxis, :, :] # (1, 6, 100)\n\n\n# ==============================================================================\n# MODULE 2: PDR DETECTOR (WEINBERG MODEL)\n# ==============================================================================\nclass PDRDetector:\n    \"\"\"Deterministic step counter and biomechanical Weinberg stride estimator.\"\"\"\n    def __init__(self, sample_rate_hz: float = 100.0, min_step_interval_s: float = 0.35):\n        self.fs = sample_rate_hz\n        self.min_step_interval = min_step_interval_s\n        self.k_weinberg = 0.42  # Personal calibration constant\n        self.buffer = deque(maxlen=int(sample_rate_hz * 1.0))\n        self.time_buffer = deque(maxlen=int(sample_rate_hz * 1.0))\n        self.last_step_time = -1.0\n\n    def add_sample(self, timestamp_s: float, ax: float, ay: float, az: float) -> Optional[Tuple[float, float]]:\n        mag = float(np.sqrt(ax * ax + ay * ay + az * az))\n        self.buffer.append(mag)\n        self.time_buffer.append(timestamp_s)\n\n        if len(self.buffer) < 20:\n            return None\n        if self.last_step_time > 0 and (timestamp_s - self.last_step_time) < self.min_step_interval:\n            return None\n\n        m = list(self.buffer)\n        if len(m) >= 3:\n            curr, prev, nxt = m[-2], m[-3], m[-1]\n            bounce = curr - float(np.mean(m))\n            # Peak detection above gravity baseline\n            if curr > prev and curr > nxt and bounce > 0.65:\n                self.last_step_time = self.time_buffer[-2]\n                delta_a = max(0.1, max(m[-30:]) - min(m[-30:]))\n                step_length = float(np.clip(self.k_weinberg * (delta_a ** 0.25), 0.35, 1.15))\n                return (step_length, self.last_step_time)\n        return None\n\n\n# ==============================================================================\n# MODULE 3: MODE MANAGER (HYSTERESIS STATE MACHINE)\n# ==============================================================================\nclass NavigationMode(str, Enum):\n    STATIONARY = \"STATIONARY\"\n    VEHICLE = \"VEHICLE\"\n    PEDESTRIAN = \"PEDESTRIAN\"\n\nclass ModeManager:\n    \"\"\"Debounces raw neural classifier outputs over a 1.5s sliding window.\"\"\"\n    def __init__(self, window_size: int = 15):\n        self.history = deque(maxlen=window_size)\n        self.current_mode = NavigationMode.STATIONARY\n\n    def update(self, raw_class_id: int) -> NavigationMode:\n        mapping = {0: NavigationMode.STATIONARY, 1: NavigationMode.VEHICLE, 2: NavigationMode.VEHICLE, 3: NavigationMode.PEDESTRIAN}\n        candidate = mapping.get(raw_class_id, self.current_mode)\n        self.history.append(candidate)\n\n        n = len(self.history)\n        r_stat = sum(1 for m in self.history if m == NavigationMode.STATIONARY) / n\n        r_veh = sum(1 for m in self.history if m == NavigationMode.VEHICLE) / n\n        r_ped = sum(1 for m in self.history if m == NavigationMode.PEDESTRIAN) / n\n\n        if self.current_mode == NavigationMode.STATIONARY:\n            if r_veh >= 0.50: self.current_mode = NavigationMode.VEHICLE\n            elif r_ped >= 0.50: self.current_mode = NavigationMode.PEDESTRIAN\n        elif self.current_mode == NavigationMode.VEHICLE:\n            if r_stat >= 0.65: self.current_mode = NavigationMode.STATIONARY\n            elif r_ped >= 0.70: self.current_mode = NavigationMode.PEDESTRIAN\n        elif self.current_mode == NavigationMode.PEDESTRIAN:\n            if r_stat >= 0.65: self.current_mode = NavigationMode.STATIONARY\n            elif r_veh >= 0.70: self.current_mode = NavigationMode.VEHICLE\n\n        return self.current_mode\n\n\n# ==============================================================================\n# MODULE 4: GNSS QUALITY MANAGER\n# ==============================================================================\nclass GNSSQuality(str, Enum):\n    GOOD = \"GOOD\"\n    DEGRADED = \"DEGRADED\"\n    LOST = \"LOST\"\n\nclass GNSSManager:\n    \"\"\"Evaluates satellite health and constructs dynamic EKF measurement covariance.\"\"\"\n    def __init__(self, good_thresh: float = 10.0, degraded_thresh: float = 30.0):\n        self.good_thresh = good_thresh\n        self.degraded_thresh = degraded_thresh\n        self.last_fix_time: Optional[float] = None\n\n    def evaluate_fix(self, timestamp_s, lat, lon, acc_m, speed_mps) -> Tuple[GNSSQuality, Optional[np.ndarray]]:\n        if lat is None or lon is None or acc_m is None or np.isnan(lat) or np.isnan(acc_m):\n            return GNSSQuality.LOST, None\n\n        if acc_m <= self.good_thresh:\n            sigma_pos = max(1.5, float(acc_m))\n            R_cov = np.diag([sigma_pos**2, sigma_pos**2, 0.5**2]).astype(np.float64)\n            return GNSSQuality.GOOD, R_cov\n        elif acc_m <= self.degraded_thresh:\n            sigma_pos = float(acc_m) * np.sqrt(8.0)\n            R_cov = np.diag([sigma_pos**2, sigma_pos**2, 1.0**2]).astype(np.float64)\n            return GNSSQuality.DEGRADED, R_cov\n        else:\n            return GNSSQuality.LOST, None\n\n\n# ==============================================================================\n# MODULE 5: TOPOLOGICAL MAP MATCHER\n# ==============================================================================\nclass MapMatcher:\n    \"\"\"Snaps dead-reckoned coordinates to candidate forest trails and roads.\"\"\"\n    def __init__(self, max_snap_dist_m: float = 35.0, max_heading_diff_deg: float = 55.0):\n        self.max_snap_dist = max_snap_dist_m\n        self.max_heading_diff = max_heading_diff_deg\n        self.segments: List[Dict[str, Any]] = []\n        self.origin_lat, self.origin_lon = None, None\n        self.cos_lat0 = 1.0\n\n    def load_trail(self, lats: List[float], lons: List[float]):\n        self.origin_lat, self.origin_lon = lats[0], lons[0]\n        self.cos_lat0 = float(np.cos(np.radians(self.origin_lat)))\n        self.segments.clear()\n\n        # Simplify vertices (every 15m)\n        s_lats, s_lons = [lats[0]], [lons[0]]\n        for i in range(1, len(lats)):\n            if haversine_m(s_lats[-1], s_lons[-1], lats[i], lons[i]) >= 15.0 or i == len(lats) - 1:\n                s_lats.append(lats[i]); s_lons.append(lons[i])\n\n        pts = []\n        for la, lo in zip(s_lats, s_lons):\n            pN = np.radians(la - self.origin_lat) * R_EARTH\n            pE = np.radians(lo - self.origin_lon) * R_EARTH * self.cos_lat0\n            pts.append(np.array([pE, pN]))\n\n        for i in range(len(pts) - 1):\n            p1, p2 = pts[i], pts[i + 1]\n            bearing = (float(np.degrees(np.arctan2(p2[0] - p1[0], p2[1] - p1[1]))) + 360.0) % 360.0\n            self.segments.append({\n                \"p1\": p1, \"p2\": p2, \"bearing\": bearing,\n                \"bbox\": (min(p1[0], p2[0]) - self.max_snap_dist, max(p1[0], p2[0]) + self.max_snap_dist,\n                         min(p1[1], p2[1]) - self.max_snap_dist, max(p1[1], p2[1]) + self.max_snap_dist)\n            })\n\n    def match(self, lat: float, lon: float, heading_deg: float) -> Tuple[float, float, bool]:\n        if not self.segments or self.origin_lat is None:\n            return lat, lon, False\n\n        pN = float(np.radians(lat - self.origin_lat) * R_EARTH)\n        pE = float(np.radians(lon - self.origin_lon) * R_EARTH * self.cos_lat0)\n        p = np.array([pE, pN])\n\n        best_dist = float(\"inf\")\n        best_proj = None\n\n        for seg in self.segments:\n            bb = seg[\"bbox\"]\n            if not (bb[0] <= pE <= bb[1] and bb[2] <= pN <= bb[3]):\n                continue\n\n            h_diff = abs((heading_deg - seg[\"bearing\"] + 180.0) % 360.0 - 180.0)\n            if h_diff > self.max_heading_diff and (180.0 - h_diff) > self.max_heading_diff:\n                continue\n\n            ab = seg[\"p2\"] - seg[\"p1\"]\n            t = max(0.0, min(1.0, float(np.dot(p - seg[\"p1\"], ab) / np.dot(ab, ab))))\n            proj = seg[\"p1\"] + t * ab\n            dist = float(np.linalg.norm(p - proj))\n\n            if dist < best_dist:\n                best_dist, best_proj = dist, proj\n\n        if best_dist <= self.max_snap_dist and best_proj is not None:\n            snapped_lat = self.origin_lat + np.degrees(best_proj[1] / R_EARTH)\n            snapped_lon = self.origin_lon + np.degrees(best_proj[0] / (R_EARTH * self.cos_lat0))\n            return float(snapped_lat), float(snapped_lon), True\n\n        return lat, lon, False\n\n\n# ==============================================================================\n# MODULE 6: 5-STATE EXTENDED KALMAN FILTER (EKF) FUSION ENGINE\n# ==============================================================================\n@dataclass\nclass NavigationState:\n    timestamp_s: float\n    lat: float; lon: float\n    matched_lat: float; matched_lon: float; is_snapped: bool\n    speed_kmh: float; heading_deg: float; gyro_bias_rads: float\n    mode: str; gnss_quality: str; is_outage: bool\n\nclass FusionEngine:\n    \"\"\"\n    State: x = [p_E, p_N, v, psi, b_g]^T\n    Integrates Auto-Leveling Gravity Alignment, Dual Neural Models, and Gated ZUPT/ZARU.\n    \"\"\"\n    def __init__(self, cls_onnx: str, spd_onnx: str, ped_onnx: Optional[str] = None):\n        opts = ort.SessionOptions()\n        opts.intra_op_num_threads = 1\n        self.sess_cls = ort.InferenceSession(cls_onnx, opts)\n        self.sess_spd = ort.InferenceSession(spd_onnx, opts)\n        self.sess_ped = ort.InferenceSession(ped_onnx, opts) if ped_onnx and os.path.exists(ped_onnx) else None\n\n        self.preprocessor = SensorPreprocessor(target_freq_hz=100.0)\n        self.pdr = PDRDetector(sample_rate_hz=100.0)\n        self.mode_mgr = ModeManager()\n        self.gnss_mgr = GNSSManager()\n        self.map_matcher = MapMatcher()\n\n        self.origin_lat, self.origin_lon = None, None\n        self.cos_lat0 = 1.0\n        self.heading_initialized = False\n\n        # Invariant Auto-Leveling Gravity Vector\n        self.g_down = np.array([0.0, 0.0, 1.0], dtype=np.float64)\n        self.speed_scale_factor = 1.0\n\n        # State x: [p_E, p_N, v, psi, b_g]\n        self.x = np.zeros(5, dtype=np.float64)\n        self.P = np.diag([10.0, 10.0, 2.0, 0.15, 1e-4]).astype(np.float64)\n        self.Q_base = np.diag([0.02, 0.02, 0.30, 0.001, 1e-7]).astype(np.float64)\n\n        self.sample_counter = 0\n        self.current_tcn_speed = 0.0\n        self.current_ped_speed = 0.0\n        self.current_raw_class = 0\n\n    def load_trail(self, lats, lons):\n        self.map_matcher.load_trail(lats, lons)\n\n    def set_origin(self, lat: float, lon: float):\n        self.origin_lat, self.origin_lon = lat, lon\n        self.cos_lat0 = float(np.cos(np.radians(lat)))\n\n    def step(self, t, ax, ay, az, gx, gy, gz, lat=None, lon=None, speed=None, acc=None, bearing=None) -> NavigationState:\n        sample = self.preprocessor.add_sample(t, ax, ay, az, gx, gy, gz, lat, lon, speed, acc, bearing)\n        dt = sample.dt\n        self.sample_counter += 1\n\n        gnss_qual, R_gnss = self.gnss_mgr.evaluate_fix(t, lat, lon, acc, speed)\n        is_outage = (gnss_qual == GNSSQuality.LOST)\n\n        if self.origin_lat is None and gnss_qual == GNSSQuality.GOOD and lat is not None:\n            self.set_origin(lat, lon)\n\n        # Neural Inference at 10 Hz\n        if self.preprocessor.is_ready() and (self.sample_counter % 10 == 0):\n            cls_win = self.preprocessor.get