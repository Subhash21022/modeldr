    X_samples.append(w_feat)\n    y_labels.append(label)\n\n# 3. Add Walking Windows (70% ForestBack + 30% RoNiN)\nfb_feats = np.column_stack([\n    df_fb['acc_x_mps2'].values, df_fb['acc_y_mps2'].values, df_fb['acc_z_mps2'].values,\n    np.zeros(len(df_fb)), np.zeros(len(df_fb)), df_fb['gyro_z_rads'].values\n]).astype(np.float32)\nfb_windows = [fb_feats[i : i + win] for i in range(0, len(fb_feats) - win, step)]\n\nr_feats = df_ronin[['ax', 'ay', 'az', 'gx', 'gy', 'gz']].values.astype(np.float32)\nronin_windows = [r_feats[i : i + win] for i in range(0, len(r_feats) - win, step)]\n\ntarget_walk = min(len(fb_windows), 3000)\nn_fb, n_ronin = int(target_walk * 0.7), int(target_walk * 0.3)\n\nnp.random.seed(42)\nfor idx in np.random.choice(len(fb_windows), n_fb, replace=False):\n    X_samples.append(fb_windows[idx])\n    y_labels.append(3)\n\nfor idx in np.random.choice(len(ronin_windows), n_ronin, replace=False):\n    X_samples.append(ronin_windows[idx])\n    y_labels.append(3)\n\nX_arr = np.array(X_samples, dtype=np.float32)\ny_arr = np.array(y_labels, dtype=np.int64)\n\n# 4. Train-Test Split (80/20)\nindices = np.random.permutation(len(y_arr))\nsplit = int(0.8 * len(y_arr))\nX_train, y_train = X_arr[indices[:split]], y_arr[indices[:split]]\nX_test, y_test = X_arr[indices[split:]], y_arr[indices[split:]]\n\ntrain_loader = DataLoader(\n    list(zip(torch.from_numpy(X_train), torch.from_numpy(y_train))), \n    batch_size=128, \n    shuffle=True\n)\n\nprint(f\"📊 BALANCED CLASS SAMPLES:\")\nfor c_idx, c_name in enumerate(CLASS_NAMES):\n    print(f\"   {c_name:<16}: {np.sum(y_arr == c_idx):,} windows\")\n\n# 5. Re-Train GRU\nclass MotionClassifierGRU(nn.Module):\n    def __init__(self, in_features=6, hidden_dim=64, num_layers=2, num_classes=4, dropout=0.2):\n        super().__init__()\n        self.gru = nn.GRU(in_features, hidden_dim, num_layers=num_layers, batch_first=True, dropout=dropout)\n        self.classifier = nn.Sequential(\n            nn.Linear(hidden_dim, 32),\n            nn.ReLU(),\n            nn.Dropout(dropout),\n            nn.Linear(32, num_classes)\n        )\n    def forward(self, x):\n        out, _ = self.gru(x)\n        return self.classifier(out[:, -1, :])\n\nmodel = MotionClassifierGRU().to(device)\ncriterion = nn.CrossEntropyLoss()\noptimizer = torch.optim.AdamW(model.parameters(), lr=1e-3, weight_decay=1e-4)\n\nprint(\"\\n🚀 Training Rebalanced GRU...\")\nfor epoch in range(1, 11):\n    model.train()\n    total_loss, correct = 0.0, 0\n    for xb, yb in train_loader:\n        xb, yb = xb.to(device), yb.to(device)\n        optimizer.zero_grad()\n        out = model(xb)\n        loss = criterion(out, yb)\n        loss.backward()\n        optimizer.step()\n        total_loss += loss.item() * len(yb)\n        correct += (torch.argmax(out, dim=1) == yb).sum().item()\n    print(f\"Epoch {epoch:02d}/10 | Loss: {total_loss/len(X_train):.4f} | Acc: {correct/len(X_train)*100:.2f}%\")\n\n# 6. Evaluation\nmodel.eval()\nwith torch.no_grad():\n    preds = torch.argmax(model(torch.from_numpy(X_test).to(device)), dim=1).cpu().numpy()\n\nprint(\"\\n\" + \"=\"*55)\nprint(f\"Balanced Accuracy: {accuracy_score(y_test, preds)*100:.2f}%\\n\")\nprint(classification_report(y_test, preds, target_names=CLASS_NAMES, digits=4))\nprint(\"Confusion Matrix:\")\nprint(confusion_matrix(y_test, preds))\nprint(\"=\"*55)\n\n# 7. Export Balanced ONNX\ntorch.save(model.state_dict(), '/kaggle/working/motion_classifier.pth')\ntorch.onnx.export(\n    model, torch.randn(1, 100, 6, device=device),\n    '/kaggle/working/motion_classifier.onnx',\n    input_names=[\"imu_sequence\"], output_names=[\"motion_logits\"],\n    dynamic_axes={\"imu_sequence\": {0: \"batch_size\"}}, opset_version=14, dynamo=False\n)\ndisplay(FileLink('motion_classifier.onnx'))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-03T06:56:26.655853Z","iopub.execute_input":"2026-10-03T06:56:26.656237Z","iopub.status.idle":"2026-10-03T06:56:36.610944Z","shell.execu