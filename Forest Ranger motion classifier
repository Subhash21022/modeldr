gru.state_dict(), pth_path)\n\ndummy_input = torch.randn(1, 100, 6, device=device)\ntorch.onnx.export(\n    model_gru,\n    dummy_input,\n    onnx_path,\n    input_names=[\"imu_sequence\"],\n    output_names=[\"motion_logits\"],\n    dynamic_axes={\"imu_sequence\": {0: \"batch_size\"}},\n    opset_version=14,\n    dynamo=False\n)\n\nprint(f\"✅ Saved PyTorch model: {pth_path}\")\nprint(f\"✅ Exported ONNX classifier: {onnx_path} ({os.path.getsize(onnx_path)/1024:.1f} KB)\\n\")\n\nprint(\"Click below to download your Motion Classifier:\")\ndisplay(FileLink('motion_classifier.onnx'))\ndisplay(FileLink('motion_classifier.pth'))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-03T05:15:14.673412Z","iopub.execute_input":"2026-10-03T05:15:14.673693Z","iopub.status.idle":"2026-10-03T05:15:26.360495Z","shell.execute_reply.started":"2026-10-03T05:15:14.673673Z","shell.execute_reply":"2026-10-03T05:15:26.359871Z"}},"outputs":[{"name":"stdout","text":"✅ Active compute device: cuda\nLoading Vehicle Telematics: /kaggle/input/datasets/subhashb21022/scooter-test-data/scooter_test_all_100hz.csv\nExtracted 19,919 vehicle and stationary windows.\nLoading ForestBack Data: /kaggle/input/datasets/subhashb21022/forestback-indoor-pdr-dataset/forestback_indoor_pdr_dataset.csv\nLoading RoNiN Data: /kaggle/input/datasets/subhashb21022/ronin-walking-sample/ronin_walking_sample_100hz.csv\n\n=======================================================\n🚶 WALKING DATASET COMPOSITION (Class 3):\n   • ForestBack (Forest Walking) : 1,483 windows (70.0%)\n   • RoNiN (Academic Benchmark)  : 635 windows (30.0%)\n   • Total Walking Windows       : 2,119 (100% Real Sensor Data)\n=======================================================\n\n📊 OVERALL CLASS BALANCE:\n   Class 0 [Stationary      ]: 1,290 windows\n   Class 1 [Vehicle_Cruising]: 872 windows\n   Class 2 [Vehicle_Turning ]: 17,757 windows\n   Class 3 [Walking         ]: 2,118 windows\n   Train: 17,629 | Test: 4,408\n\n🚀 Training GRU