.numpy().flatten()\n    raw_preds_mps = np.maximum(0.0, raw_preds_mps)\n\nraw_preds_kmh = raw_preds_mps * 3.6\ngt_kmh = y_test.numpy().flatten() * 3.6\ngt_mps = y_test.numpy().flatten()\n\n# Smart ZUPT\nsmart_preds_kmh = raw_preds_kmh.copy()\nis_stopped = (raw_preds_kmh < 7.0) & (test_gyro_std < 0.28)\nsmart_preds_kmh[is_stopped] = 0.0\n\n# 5-sample moving average smoothing\nfinal_preds_kmh = pd.Series(smart_preds_kmh).rolling(window=5, min_periods=1).mean().values\nfinal_preds_mps = final_preds_kmh / 3.6\n\n# =============================================================\n# 2. CALCULATE SPEED ESTIMATION METRICS\n# =============================================================\nspeed_mae = np.mean(np.abs(final_preds_kmh - gt_kmh))\nspeed_rmse = np.sqrt(np.mean((final_preds_kmh - gt_kmh) ** 2))\nspeed_r2 = r2_score(gt_kmh, final_preds_kmh)\nmax_error = np.max(np.abs(final_preds_kmh - gt_kmh))\n\n# =============================================================\n# 3. GNSS OUTAGE SIMULATION & DEAD RECKONING DRIFT EVALUATION\n# =============================================================\n# Simulate entering a dense forest between t = 100s and t = 220s (120s outage)\noutage_start_s = 100.0\noutage_end_s = 220.0\ndt = 0.01  # 100 Hz sensor rate\n\n# Convert Latitude/Longitude to local planar coordinates (meters)\nlat0, lon0 = df_test['lat'].iloc[0], df_test['lon'].iloc[0]\nR_earth = 6371000.0  # Earth radius in meters\ny_true_m = np.radians(df_test['lat'].values - lat0) * R_earth\nx_true_m = np.radians(df_test['lon'].values - lon0) * R_earth * np.cos(np.radians(lat0))\n\n# Locate the outage time window in the 100Hz test stream\ntime_arr = df_test['time_s'].values\nmask_outage = (time_arr >= outage_start_s) & (time_arr <= outage_end_s)\nidx_start = np.where(mask_outage)[0][0]\nidx_end = np.where(mask_outage)[0][-1]\n\n# Interpolate 1-sec model predictions to 100Hz for trajectory integration\ninterp_speed_100hz = np.interp(\n    np.arange(len(df_test)), \n    np.linspace(0, len(df_test), len(final_preds_mps)), \n    final_preds_mps\n)\n\n# Integrate Dead Reckoning during the outage\ndr_x = [x_true_m[idx_start]]\ndr_y = [y_true_m[idx_start]]\n\nfor i in range(idx_start, idx_end):\n    heading_rad = np.radians(df_test['bearing_deg'].iloc[i])\n    spd = interp_speed_100hz[i]\n    dr_x.append(dr_x[-1] + spd * np.sin(heading_rad) * dt)\n    dr_y.append(dr_y[-1] + spd * np.cos(heading_rad) * dt)\n\n# Final position error at the moment GNSS returns\nfinal_pos_error_m = np.sqrt((dr_x[-1] - x_true_m[idx_end])**2 + (dr_y[-1] - y_true_m[idx_end])**2)\ndist_traveled_m = np.sum(df_test['speed_mps'].iloc[idx_start:idx_end]) * dt\ndrift_percent = (final_pos_error_m / dist_traveled_m) * 100.0\n\n# =============================================================\n# 4. PRINT FORMATTED EVALUATION REPORT\n# =============================================================\nprint(\"\\n\" + \"=\"*60)\nprint(\"     FOREST RANGER IDR SYSTEM — BENCHMARK EVALUATION\")\nprint(\"=\"*60)\nprint(\"1. SPEED ESTIMATOR METRICS:\")\nprint(f\"   • Mean Absolute Error (MAE) : {speed_mae:.2f} km/h ({speed_mae/3.6:.2f} m/s)\")\nprint(f\"   • Root Mean Sq Error (RMSE) : {speed_rmse:.2f} km/h ({speed_rmse/3.6:.2f} m/s)\")\nprint(f\"   • Coefficient of Det (R²)   : {speed_r2:.4f}  (1.0 = Perfect fit)\")\nprint(f\"   • Maximum Observed Error    : {max_error:.2f} km/h\")\nprint(\"-\" * 60)\nprint(\"2. GNSS OUTAGE DEAD RECKONING BENCHMARK:\")\nprint(f\"   • Outage Duration (Forest)  : {outage_end_s - outage_start_s:.0f} seconds (2.0 minutes)\")\nprint(f\"   • Distance Covered in Outage: {dist_traveled_m:.1f} meters ({dist_traveled_m/1000:.2f} km)\")\nprint(f\"   • End Position Error (ATE)  : {final_pos_error_m:.2f} meters\")\nprint(f\"   • Position Drift (%)        : {drift_percent:.2f} %\")\nif drift_percent < 5.0:\n    print(f\"   • Evaluation Status         : 🌟 EXCEEDED DESIRED TARGET (< 5.0%)\")\nelif drift_percent < 10.0:\n    print(f\"   • Evaluation Status         : ✅ PASSED TARGET (< 10.0%)\")\nelse:\n    print(f\"   • Evaluation Status         : ⚠️ REQUIRES HEADING TUNING\")\nprint(\"=\"*60 + \"\\n\")\n\n# =============================================================\n# 5. VISUALIZATION DASHBOARD (3 PLOTS)\n# =============================================================\nfig, axes = plt.subplots(1, 3, figsize=(18, 5))\n\n# Plot 1: Speed Profile with Outage Highlight\nt_axis = np.arange(len(gt_kmh[:500]))\naxes[0].plot(t_axis, gt_kmh[:500], color='black', label='Actual GPS (km/h)', alpha=0.8)\naxes[0].plot(t_axis, final_preds_kmh[:500], color='#00aa44', label='AI Estimator (km/h)', alpha=0.9)\naxes[0].axvspan(outage_start_s, outage_end_s, color='red', alpha=0.15, label='GNSS Outage Zone')\naxes[0].set_title('A. Speed Estimation & Outage Window')\naxes[0].set_xlabel('Time (seconds)')\naxes[0].set_ylabel('Speed (km/h)')\naxes[0].legend(loc='upper right')\naxes[0].grid(True, linestyle='--', alpha=0.5)\n\n# Plot 2: 2D Trajectory Map (GNSS vs Dead Reckoned)\naxes[1].plot(x_true_m, y_true_m, color='black', linestyle=':', label='Actual GPS Track', alpha=0.7)\naxes[1].plot(x_true_m[idx_start:idx_end], y_true_m[idx_start:idx_end], color='blue', linewidth=2.5, label='True Outage Path')\naxes[1].plot(dr_x, dr_y, color='red', linestyle='--', linewidth=2.0, label='AI Dead Reckoned Path')\naxes[1].scatter([dr_x[0]], [dr_y[0]], color='green', s=70, zorder=5, label='GNSS Lost')\naxes[1].scatter([dr_x[-1]], [dr_y[-1]], color='red', s=70, zorder=5, label='GNSS Restored')\naxes[1].set_title(f'B. 2D Dead Reckoning Trajectory (Drift: {drift_percent:.1f}%)')\naxes[1].set_xlabel('East Displacement (meters)')\naxes[1].set_ylabel('North Displacement (meters)')\naxes[1].legend(loc='best')\naxes[1].grid(True, linestyle='--', alpha=0.5)\n\n# Plot 3: Error Distribution Histogram\nspeed_errors = np.abs(final_preds_kmh - gt_kmh)\naxes[2].hist(speed_errors, bins=30, color='#0066cc', edgecolor='black', alpha=0.7)\naxes[2].axvline(speed_mae, color='red', linestyle='dashed', linewidth=1.5, label=f'MAE: {speed_mae:.2f} km/h')\naxes[2].set_title('C. Absolute Error Distribution')\naxes[2].set_xlabel('Error (km/h)')\naxes[2].set_ylabel('Frequency')\naxes[2].legend()\naxes[2].grid(True, linestyle='--', alpha=0.5)\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T17:26:57.500085Z","iopub.execute_input":"2026-10-02T17:26:57.500684Z","iopub.status.idle":"2026-10-02T17:26:59.340373Z","shell.execute_reply.started":"2026-10-02T17:26:57.500656Z","shell.execute_reply":"2026-10-02T17:26:59.339513Z"}},"outputs":[{"name":"stdout","text":"\n============================================================\n     FOREST RANGER IDR SYSTEM — BENCHMARK EVALUATION\n============================================================\n1. SPEED ESTIMATOR METRICS:\n   • Mean Absolute Error (MAE) : 3.43 km/h (0.95 m/s)\n   • Root Mean Sq Error (RMSE) : 4.59 km/h (1.27 m/s)\n   • Coefficient of Det (R²)   : 0.8501  (1.0 = Perfect fit)\n   • Maximum Observed Error    : 15.72 km/h\n------------------------------------------------------------\n2. GNSS OUTAGE DEAD RECKONING BENCHMARK:\n   • Outage Duration (Forest)  : 120 seconds (2.0 minutes)\n   • Distance Covered in Outage: 767.1 meters (0.77 km)\n   • End Position Error (ATE)  : 68.32 meters\n   • Position Drift (%)        : 8.91 %\n   • Evaluation Status         : ✅ PASSED TARGET (< 10.0%)\n============================================================\n\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1800x500 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":15},{"cell_type":"code","source":"import os\nimport glob\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom IPython.display import FileLink, display\nimport matplotlib.pyplot as plt\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(\"✅ Compute Device:\", device)\n\n# =============================================================\n# 1. LOAD CAR DATA (IO-VNBD)\n# =============================================================\ns_paths = [\n    os.path.join(root, f) \n    for root, _, files in os.walk('/kaggle/working') \n    for f in files if f.startswith('S-') and f.endswith('.csv')\n]\n\ncar_train_seqs, car_train_spds = [], []\ncar_test_seqs, car_test_spds = [], []\n\ndef find_col(columns, sensor_kw, axis_kw):\n    for c in columns:\n        if sensor_kw.lower() in c.lower() and axis_kw.lower() in c.lower():\n            return c\n    raise ValueError(f\"Could not find {sensor_kw} {axis_kw}\")\n\nprint(f\"Loading Car Sessions from IO-VNBD...\")\nfor idx, path in enumerate(s_paths[:22]):  # First 20 for train, last 2 for test\n    try:\n        df = pd.read_csv(path, encoding='latin1')\n        df.columns = df.columns.str.strip()\n        \n        ax = find_col(df.columns, 'accel', ' x')\n        ay = find_col(df.columns, 'accel', ' y')\n        az = find_col(df.columns, 'accel', ' z')\n        gx = find_col(df.columns, 'gyro', 'yaw')\n        gy = find_col(df.columns, 'gyro', 'pitch')\n        gz = find_col(df.columns, 'gyro', 'roll')\n        spd = next(c for c in df.columns if 'speed' in c.lower())\n        \n        cols = [ax, ay, az, gx, gy, gz]\n        imu_df = df[cols].apply(pd.to_numeric, errors='coerce').ffill().bfill().fillna(0.0)\n        speed_series = pd.to_numeric(df[spd], errors='coerce').ffill().bfill().fillna(0.0)\n        \n        feat = imu_df.values.astype(np.float32)\n        tgt = (speed_series.values / 3.6).astype(np.float32)\n        \n        if len(feat) > 100:\n            if idx < 18:\n                car_train_seqs.append(feat)\n                car_train_spds.append(tgt)\n            else:\n                car_test_seqs.append(feat)\n                car_test_spds.append(tgt)\n    except Exception:\n        continue\n\nprint(f\"✅ Loaded {len(car_train_seqs)} Car training trips and {len(car_test_seqs)} Car test trips.\")\n\n# =============================================================\n# 2. LOAD BIKE/SCOOTER DATA\n# =============================================================\nscooter_csv = None\nfor root, _, files in os.walk('/kaggle/input'):\n    for f in files:\n        if 'scooter' in f.lower() and f.endswith('.csv'):\n            scooter_csv = os.path.join(root, f)\n            break\n\ndf_all = pd.read_csv(scooter_csv)\n\n# Use datasets 1, 5, 9, 10 for training (~12 km)\n# Keep dataset 2 as the unseen test trip (~6.3 km)\ntrain_ids = ['dataset_1', 'dataset_5', 'dataset_9', 'dataset_10']\ndf_bike_train = df_all[df_all['dataset_id'].isin(train_ids)]\ndf_bike_test = df_all[df_all['dataset_id'] == 'dataset_2']\n\ndef extract_windows_from_df(df, win=100, step=10):\n    feats = df[['ax', 'ay', 'az', 'gx', 'gy', 'gz']].values.astype(np.float32)\n    spds = df['speed_mps'].values.astype(np.float32)\n    X, y, gyro_stds = [], [], []\n    for i in range(0, len(feats) - win, step):\n        w_feat = feats[i : i + win]\n        X.append(w_feat)\n        y.append(spds[i + win - 1])\n        w_gyro = np.sqrt(w_feat[:, 3]**2 + w_feat[:, 4]**2 + w_feat[:, 5]**2)\n        gyro_stds.append(w_gyro.std())\n    return X, y, np.array(gyro_stds)\n\nbike_train_X, bike_train_y, _ = extract_windows_from_df(df_bike_train, win=100, step=15)\nbike_test_X, bike_test_y, bike_test_gyro = extract_windows_from_df(df_bike_test, win=100, step=100)\n\nprint(f\"✅ Extracted {len(bike_train_X):,} Bike training windows and {len(bike_test_X):,} Bike test windows.\")\n\n# =============================================================\n# 3. MERGE INTO BALANCED JOINT DATASET\n# =============================================================\ndef extract_windows_from_seqs(seqs, spds, win=100, step=10):\n    X, y = [], []\n    for feat, tgt in zip(seqs, spds):\n        for i in range(0, len(feat) - win, step):\n            X.append(feat[i : i + win])\n            y.append(tgt[i + win - 1])\n    return X, y\n\ncar_train_X, car_train_y = extract_windows_from_seqs(car_train_seqs, car_train_spds, win=100, step=10)\ncar_test_X, car_test_y = extract_windows_from_seqs(car_test_seqs, car_test_spds, win=100, step=50)\n\n# Combine: ~70% Car Windows + ~30% Bike Windows\nall_train_X = car_train_X + bike_train_X\nall_train_y = car_train_y + bike_train_y\n\nX_train_tensor = torch.from_numpy(np.array(all_train_X, dtype=np.float32)).permute(0, 2, 1)\ny_train_tensor = torch.from_numpy(np.array(all_train_y, dtype=np.float32)).unsqueeze(1)\n\ntrain_loader = DataLoader(\n    list(zip(X_train_tensor, y_train_tensor)), \n    batch_size=256, \n    shuffle=True  # Shuffles cars and bikes together in every batch!\n)\n\nprint(f\"\\n=======================================================\")\nprint(f\"🚀 TOTAL JOINT DATASET: {len(X_train_tensor):,} windows\")\nprint(f\"   • Car Windows  : {len(car_train_X):,} ({len(car_train_X)/len(X_train_tensor)*100:.1f}%)\")\nprint(f\"   • Bike Windows : {len(bike_train_X):,} ({len(bike_train_X)/len(X_train_tensor)*100:.1f}%)\")\nprint(f\"=======================================================\\n\")\n\n# =============================================================\n# 4. UNIVERSAL MODEL ARCHITECTURE & TRAINING\n# =============================================================\nclass UniversalSpeedEstimator(nn.Module):\n    def __init__(self, in_channels=6):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv1d(in_channels, 32, kernel_size=3, padding=1),\n            nn.BatchNorm1d(32),\n            nn.ReLU(),\n            nn.Conv1d(32, 64, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(64),\n            nn.ReLU(),\n            nn.Conv1d(64, 128, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(128),\n            nn.ReLU(),\n            nn.AdaptiveAvgPool1d(1),\n            nn.Flatten(),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nuniversal_model = UniversalSpeedEstimator().to(device)\ncriterion = nn.HuberLoss(delta=1.0)\noptimizer = torch.optim.AdamW(universal_model.parameters(), lr=1e-3, weight_decay=1e-4)\n\nepochs = 10\nprint(f\"🔥 Training Universal Model on mixed Car + Bike dynamics for {epochs} epochs...\\n\")\n\nfor epoch in range(1, epochs + 1):\n    universal_model.train()\n    total_loss = 0.0\n    for xb, yb in train_loader:\n        xb, yb = xb.to(device), yb.to(device)\n        optimizer.zero_grad()\n        loss = criterion(universal_model(xb), yb)\n        loss.backward()\n        optimizer.step()\n        total_loss += loss.item() * len(yb)\n    \n    avg_loss = total_loss / len(X_train_tensor)\n    print(f\"Epoch [{epoch:02d}/{epochs:02d}] ── Huber Loss: {avg_loss:.4f}\")\n\n# =============================================================\n# 5. DUAL EVALUATION: TEST ON BOTH UNSEEN CAR & UNSEEN BIKE\n# =============================================================\nuniversal_model.eval()\n\n# --- Evaluate on Unseen Scooter Run (dataset_2) ---\nX_bike_tensor = torch.from_numpy(np.array(bike_test_X, dtype=np.float32)).permute(0, 2, 1).to(device)\nwith torch.no_grad():\n    bike_preds_mps = universal_model(X_bike_tensor).cpu().numpy().flatten()\n    bike_preds_mps = np.maximum(0.0, bike_preds_mps)\n\nbike_preds_kmh = bike_preds_mps * 3.6\nbike_gt_kmh = np.array(bike_test_y) * 3.6\n\n# Smart ZUPT\nis_stopped_bike = (bike_preds_kmh < 7.0) & (bike_test_gyro < 0.28)\nbike_preds_kmh[is_stopped_bike] = 0.0\nbike_preds_kmh = pd.Series(bike_preds_kmh).rolling(window=5, min_periods=1).mean().values\nbike_mae = np.mean(np.abs(bike_preds_kmh - bike_gt_kmh))\n\n# --- Evaluate on Unseen Car Run (IO-VNBD) ---\nX_car_tensor = torch.from_numpy(np.array(car_test_X, dtype=np.float32)).permute(0, 2, 1).to(device)\nwith torch.no_grad():\n    car_preds_mps = universal_model(X_car_tensor).cpu().numpy().flatten()\n    car_preds_mps = 