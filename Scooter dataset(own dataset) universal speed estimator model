h, Roll in IO-VNBD\n        gx = find_col(data.columns, 'gyro', 'yaw')\n        gy = find_col(data.columns, 'gyro', 'pitch')\n        gz = find_col(data.columns, 'gyro', 'roll')\n        \n        spd = next(c for c in data.columns if 'speed' in c.lower())\n        \n        selected_imu = [ax, ay, az, gx, gy, gz]\n        \n        # Convert IMU and Speed to numeric floats, filling NaNs\n        imu_df = data[selected_imu].apply(pd.to_numeric, errors='coerce').ffill().bfill().fillna(0.0)\n        speed_series = pd.to_numeric(data[spd], errors='coerce').ffill().bfill().fillna(0.0)\n        \n        feat = imu_df.values.astype(np.float32)\n        target = (speed_series.values / 3.6).astype(np.float32)  # km/h -> m/s\n        \n        if len(feat) >= 100:\n            sequences.append(feat)\n            speeds.append(target)\n            \n    except Exception as e:\n        continue\n\nprint(f\"✅ Successfully loaded {len(sequences)} driving sessions!\")\nassert len(sequences) > 0, \"No driving files could be loaded. Check dataset path.\"\n\n# -------------------------------------------------------------\n# 2. Windowing Dataset (Window = 100 samples / 1 second)\n# -------------------------------------------------------------\nclass IMUSpeedDataset(Dataset):\n    def __init__(self, seqs, spds, window=100, step=10):\n        X_list, y_list = [], []\n        for feat, tgt in zip(seqs, spds):\n            for i in range(0, len(feat) - window, step):\n                X_list.append(feat[i : i + window])\n                y_list.append(tgt[i + window - 1])\n                \n        X_arr = np.array(X_list, dtype=np.float32)\n        y_arr = np.array(y_list, dtype=np.float32)\n        \n        # PyTorch Conv1D format: (Batch, Channels=6, WindowLength=100)\n        self.X = torch.from_numpy(X_arr).permute(0, 2, 1)\n        self.y = torch.from_numpy(y_arr).unsqueeze(1)\n\n    def __len__(self):\n        return len(self.y)\n\n    def __getitem__(self, idx):\n        return self.X[idx], self.y[idx]\n\ndataset = IMUSpeedDataset(sequences, speeds, window=100, step=10)\nloader = DataLoader(dataset, batch_size=256, shuffle=True)\nprint(f\"✅ Total training windows: {len(dataset):,}\")\n\n# -------------------------------------------------------------\n# 3. Model Architecture & Training Loop\n# -------------------------------------------------------------\nclass ConvSpeedEstimator(nn.Module):\n    def __init__(self, in_channels=6):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv1d(in_channels, 32, kernel_size=3, padding=1),\n            nn.BatchNorm1d(32),\n            nn.ReLU(),\n            nn.Conv1d(32, 64, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(64),\n            nn.ReLU(),\n            nn.Conv1d(64, 128, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(128),\n            nn.ReLU(),\n            nn.AdaptiveAvgPool1d(1),\n            nn.Flatten(),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n        \n    def forward(self, x):\n        return self.net(x)\n\nmodel = ConvSpeedEstimator(in_channels=6).to(device)\ncriterion = nn.HuberLoss(delta=1.0)\noptimizer = torch.optim.AdamW(model.parameters(), lr=1e-3, weight_decay=1e-4)\n\nepochs = 10\nprint(f\"🚀 Training for {epochs} epochs on {device}...\\n\")\n\nfor epoch in range(1, epochs + 1):\n    model.train()\n    total_loss = 0.0\n    for x_b, y_b in loader:\n        x_b, y_b = x_b.to(device), y_b.to(device)\n        optimizer.zero_grad()\n        loss = criterion(model(x_b), y_b)\n        loss.backward()\n        optimizer.step()\n        total_loss += loss.item() * len(y_b)\n    \n    avg_loss = total_loss / len(dataset)\n    print(f\"Epoch {epoch:02d}/10 | Huber Loss: {avg_loss:.4f}\")\n\n# -------------------------------------------------------------\n# 4. Save ONNX Model\n# -------------------------------------------------------------\ndummy = torch.randn(1, 6, 100, device=device)\ntorch.onnx.export(\n    model, \n    dummy, \n    \"/kaggle/working/speed_estimator.onnx\",\n    input_names=[\"imu_window\"],\n    output_names=[\"speed_mps\"],\n    dynamic_axes={\"imu_window\": {0: \"batch_size\"}}\n)\nprint(\"\\n✅ Successfully trained and exported model to /kaggle/working/speed_estimator.onnx\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-02T16:56:39.374828Z","iopub.execute_input":"2026-10-02T16:56:39.375527Z","iopub.status.idle":"2026-10-02T16:56:51.670825Z","shell.execute_reply.started":"2026-10-02T16:56:39.375492Z","shell.execute_reply":"2026-10-02T16:56:51.669879Z"}},"outputs":[{"name":"stdout","text":"✅ Using device: cuda\n✅ Successfully loaded 25 driving sessions!\n✅ Total training windows: 38,797\n🚀 Training for 10 epochs on cuda...\n\nEpoch 01/10 | Huber Loss: 2.0176\nEpoch 02/10 | Huber Loss: 1.3288\nEpoch 03/10 | Huber Loss: 1.2405\nEpoch 04/10 | Huber Loss: 1.1471\nEpoch 05/10 | Huber Loss: 1.0467\nEpoch 06/10 | Huber Loss: 0.9884\nEpoch 07/10 | Huber Loss: 0.9432\nEpoch 08/10 | Huber Loss: 0.9060\nEpoch 09/10 | Huber Loss: 0.8646\nEpoch 10/10 | Huber Loss: 0.8530\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mModuleNotFoundError\u001b[0m                       Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_58/2444409334.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m    143\u001b[0m \u001b[0;31m# -------------------------------------------------------------\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    144\u001b[0m \u001b[0mdummy\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mtorch\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mrandn\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;36m1\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;36m6\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;36m100\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mdevice\u001b[