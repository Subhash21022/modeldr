/td>\n      <td>...</td>\n      <td>9.8066</td>\n      <td>-0.0141</td>\n      <td>-0.2325</td>\n      <td>0.1570</td>\n      <td>-24.81</td>\n      <td>-36.12</td>\n      <td>23.31</td>\n      <td>323.84</td>\n      <td>-88.46</td>\n      <td>-167.80</td>\n    </tr>\n  </tbody>\n</table>\n<p>3 rows × 24 columns</p>\n</div>"},"metadata":{}}],"execution_count":3},{"cell_type":"code","source":"import os\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(\"Using device:\", device)\n\n# -------------------------------------------------------------\n# 1. Load Training Data with Forced Float Conversion\n# -------------------------------------------------------------\ns_paths = [\n    os.path.join(root, f) \n    for root, _, files in os.walk('/kaggle/working') \n    for f in files if f.startswith('S-') and f.endswith('.csv')\n]\n\nsequences = []\nspeeds = []\n\nfor path in s_paths[:25]:  # Train on 25 driving sessions\n    try:\n        data = pd.read_csv(path, encoding='latin1')\n        \n        # Dynamically find column names\n        ax = [c for c in data.columns if 'accel' in c.lower() and 'x' in c.lower()][0]\n        ay = [c for c in data.columns if 'accel' in c.lower() and 'y' in c.lower()][0]\n        az = [c for c in data.columns if 'accel' in c.lower() and 'z' in c.lower()][0]\n        \n        gx = [c for c in data.columns if 'gyro' in c.lower() and ('x' in c.lower() or 'yaw' in c.lower())][0]\n        gy = [c for c in data.columns if 'gyro' in c.lower() and ('y' in c.lower() or 'pitch' in c.lower())][0]\n        gz = [c for c in data.columns if 'gyro' in c.lower() and ('z' in c.lower() or 'roll' in c.lower())][0]\n        \n        spd = [c for c in data.columns if 'speed' in c.lower()][0]\n        \n        cols = [ax, ay, az, gx, gy, gz, spd]\n        \n        # Force all columns to numeric floats (converts strings/spaces to NaN)\n        for col in cols:\n            data[col] = pd.to_numeric(data[col], errors='coerce')\n            \n        # Fill any missing values\n        data[cols] = data[cols].ffill().bfill()\n        \n        # Extract as clean float32 arrays\n        feat = data[[ax, ay, az, gx, gy, gz]].values.astype(np.float32)\n        target = (data[spd].values / 3.6).astype(np.float32)  # km/h -> m/s\n        \n        # Ensure there are enough rows for a window\n        if len(feat) > 120 and not np.isnan(feat).any() and not np.isnan(target).any():\n            sequences.append(feat)\n            speeds.append(target)\n            \n    except Exception as e:\n        continue\n\nprint(f\"✅ Successfully prepared {len(sequences)} clean driving sessions for training.\")\n\n# -------------------------------------------------------------\n# 2. Windowing Dataset (Guaranteed float32 tensors)\n# -------------------------------------------------------------\nclass IMUSpeedDataset(Dataset):\n    def __init__(self, seqs, spds, window=100, step=10):\n        X_list, y_list = [], []\n        for feat, tgt in zip(seqs, spds):\n            for i in range(0, len(feat) - window, step):\n                X_list.append(feat[i : i + window])\n                y_list.append(tgt[i + window - 1])\n                \n        # Force numpy float32 conversion before passing to PyTorch\n        X_arr = np.array(X_list, dtype=np.float32)\n        y_arr = np.array(y_list, dtype=np.float32)\n        \n        self.X = torch.from_numpy(X_arr).permute(0, 2, 1)  # (Batch, 6, 100)\n        self.y = torch.from_numpy(y_arr).unsqueeze(1)      # (Batch, 1)\n\n    def __len__(self):\n        return len(self.y)\n\n    def __getitem__(self, idx):\n        return self.X[idx], self.y[idx]\n\ndataset = IMUSpeedDataset(sequences, speeds, window=100, step=10)\nloader = DataLoader(dataset, batch_size=256, shuffle=True)\nprint(f\"✅ Total training windows: {len(dataset):,}\")\n\n# -------------------------------------------------------------\n# 3. Model Definition & Training Loop\n# -------------------------------------------------------------\nclass ConvSpeedEstimator(nn.Module):\n    def __init__(self, in_channels=6):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv1d(in_channels, 32, kernel_size=3, padding=1),\n            nn.BatchNorm1d(32),\n            nn.ReLU(),\n            nn.Conv1d(32, 64, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(64),\n            nn.ReLU(),\n            nn.Conv1d(64, 128, kernel_size=3, stride=2, padding=1),\n            nn.BatchNorm1d(128),\n            nn.ReLU(),\n            nn.AdaptiveAvgPool1d(1),\n            nn.Flatten(),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = ConvSpeedEstimator().to(device)\ncriterion = nn.HuberLoss(delta=1.0)\noptimizer = torch.optim.AdamW(model.parameters(), lr=1e-3, weight_decay=1e-4)\n\nepochs = 10\nprint(f\"🚀 Training for {epochs} epochs on {device}...\\n\")\n\nfor epoch in range(1, epochs + 1):\n    model.train()\n    total_loss = 0.0\n    for x_b, y_b in loader:\n        x_b, y_b = x_b.to(device), y_b.to(device)\n        optimizer.zero_grad()\n        loss = criterion(model(x_b), y_b)\n        loss.backward()\n        optimizer.step()\n        total_loss += loss.item() * len(y_b)\n    \n    avg_loss = total_loss / len(dataset)\n    print(f\"Epoch {epoch:02d}/10 | Huber Loss: {avg_loss:.4f}\")\n\n# -------------------------------------------------------------\n# 4. Save Exported ONNX Model\n# -------------------------------------------------------------\ndummy = torch.randn(1, 6, 100, device=device)\ntorch.onnx.export(\n    model, \n    dummy, \n    \"/kaggle/working/speed_estimator.onnx\",\n    input_names=[\"imu_window\"],\n    output_names=[\"speed_mps\"],\n    dynamic_axes={\"imu_window\": {0: \"batch_size\"}}\n)\